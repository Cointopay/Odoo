<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">payment.provider.form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='provider_credentials']" position="inside">
                <group name="o_cointopay_credentials" invisible="code != 'cointopay'">
                    <field name="ctp_merchant_id" required="code == 'cointopay' and state != 'disabled'"/>
                    <field name="ctp_security_code" password="True"
                           required="code == 'cointopay' and state != 'disabled'"/>
                    <field name="ctp_account_api_key" required="code == 'cointopay' and state != 'disabled'"/>
                    <field name="ctp_coin_name" required="code == 'cointopay' and state != 'disabled'"/>
                    <field name="ctp_coin_id" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
